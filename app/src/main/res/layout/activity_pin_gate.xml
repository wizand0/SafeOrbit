<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".presentation.security.PinGateActivity">

    <!-- Иконка замка -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_lock"
        app:tint="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvPinTitle"
        app:layout_constraintVertical_chainStyle="packed"
        android:contentDescription="@string/lock_icon" />

    <!-- Заголовок -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivLockIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvPinDescription" />

    <!-- Описание -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPinDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/pin_description"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPinTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tilPinVerify" />

    <!-- Поле ввода PIN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPinVerify"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvPinDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnVerifyPin"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_visibility"
        app:endIconContentDescription="@string/toggle_pin_visibility"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPinVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_pin_hint"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:gravity="center"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопка переключения видимости -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTogglePinVisibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_pin"
        app:icon="@drawable/ic_visibility"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tilPinVerify"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Кнопка подтверждения -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyPin"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/confirm"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnTogglePinVisibility"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnResetPin"
        style="@style/Widget.Material3.Button" />

    <!-- Кнопка сброса PIN (опционально) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reset_pin"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/btnVerifyPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.Material3.Button.TextButton" />

</androidx.constraintlayout.widget.ConstraintLayout>