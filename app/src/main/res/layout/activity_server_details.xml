<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="32dp"
            android:clipToPadding="false">

            <!-- Иконка сервера -->
            <ImageView
                android:id="@+id/imageIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_marker"
                android:contentDescription="@string/server_icon" />

            <!-- Имя -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_name"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_marginBottom="8dp" />

            <!-- Координаты -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coordinates"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- Время -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- Адрес -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/address"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginTop="8dp" />

            <!-- Кнопки -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNavigate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_navigate"
                app:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRequestLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_update_coords"
                app:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:layout_marginTop="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonChangeIntervals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_change_intervals"
                app:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:layout_marginTop="12dp" />

            <!-- Уведомления -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/notifications_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNotificationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/notifications_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonExportNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_export_notifications"
                app:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:layout_marginTop="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_clear_notifications"
                app:backgroundTint="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
