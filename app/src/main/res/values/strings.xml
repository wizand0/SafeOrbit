    <string name="client_mode_title">SafeOrbit — Client Mode</string>
    <string name="client_mode_description">In client mode, you can monitor the server\'s location (e.g. a child\'s device) in real time, view detailed information and navigate to its current location.</string>
    <string name="client_mode_how_to_connect_title">How to connect to a server:</string>
    <string name="client_mode_how_to_connect_text">1. Get the server’s ID and code (manually or via QR code).\n2. Enter the data in the connection form or scan the QR code.\n3. Allow access to location.\n4. The list of connected servers will appear on the map and as a list.\n5. Tap a marker or list item to view details, or navigate.</string>
    <string name="client_mode_features_title">Client mode features:</string>
    <string name="client_mode_features_text">• Display server locations on a map\n• Scan a QR code for quick connection\n• View icon, name, coordinates, address, and last update time\n• Navigate to server via Google or Yandex Maps\n• View info in side panel (in landscape)\n• Remove connections if needed</string>
    <string name="client_mode_settings_title">Available settings:</string>
    <string name="client_mode_settings_text">• Choose preferred navigation app\n• Assign server icon from gallery or camera\n• Configure notifications\n• Manage list of connections</string>
